# Copy to .env.local for local runs. On Vercel, set these in Project Settings > Environment Variables.
# Never commit a real key.
GEMINI_API_KEY=
# Optional. Any Gemini model your key can use that supports function calling and JSON output.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional. MINIMAL, LOW, MEDIUM or HIGH. LOW keeps answers fast on models that think by default.
GEMINI_THINKING_LEVEL=
# Set to "false" to force the offline dispatcher and the rule-based crisis parser (no AI calls).
AI_ENABLED=true
